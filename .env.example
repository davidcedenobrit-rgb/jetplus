# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (correos transaccionales)
RESEND_API_KEY=
RESEND_FROM_EMAIL=cotizaciones@navigroup.co
RESEND_WEBHOOK_SECRET=

# Repuestos / Vehimotors
CORREO_VEHIMOTORS_1=aaparicio@saicve.com
CORREO_VEHIMOTORS_2=repuestos@saicve.com
CORREO_VEHIMOTORS_3=fdiaz@saicve.com
CORREO_ROJAS=
CORREO_MARY=
CORREO_OPS=

# Solo para pruebas. En produccion se ignora salvo que se habilite explicitamente.
VEHIMOTORS_TEST_OVERRIDE=
VEHIMOTORS_TEST_OVERRIDE_ALLOW_PRODUCTION=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Federación entre sedes del grupo — Jetplus es un cliente independiente,
# SIN relación con Grupo Oriente. Estas variables deben quedar VACÍAS para
# que el panel central y la sincronización entre concesionarios permanezcan
# inertes (ver src/lib/cotizacion-federada.ts y src/lib/concesionarios-externos.ts).
PANEL_MATRIZ=
CONCESIONARIO_LAORIENTAL_URL=
CONCESIONARIO_LAORIENTAL_SERVICE_KEY=
CONCESIONARIO_KIAUTO_URL=
CONCESIONARIO_KIAUTO_SERVICE_KEY=
CONCESIONARIO_AUTOSURCA_URL=
CONCESIONARIO_AUTOSURCA_SERVICE_KEY=
CONCESIONARIO_CAPITALMOTORS_URL=
CONCESIONARIO_CAPITALMOTORS_SERVICE_KEY=
